# Copiez ce fichier en .env.local et remplacez les valeurs par vos clés Supabase

# URL de votre projet Supabase
# Trouvée dans : Supabase Dashboard > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé anonyme publique Supabase
# Trouvée dans : Supabase Dashboard > Settings > API > anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_supabase

# Instructions :
# 1. Copiez ce fichier : cp env.local.example .env.local
# 2. Ouvrez .env.local avec un éditeur de texte
# 3. Remplacez les valeurs ci-dessus par vos vraies clés Supabase
# 4. Sauvegardez le fichier
# 5. Redémarrez le serveur (npm run dev)

